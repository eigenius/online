# radar environment. Copy to .env at the repo root:  cp .env.example .env
# The deno tasks load it via --env-file=../.env (relative to the radar/ dir).
# In CI/Cloud Run there's no .env — set these as real environment variables and
# the missing-file warning is harmless.

# Anthropic API key — required for `digest` and `assemble` (Haiku/Sonnet/Opus).
ANTHROPIC_API_KEY=

# GCP project for Vertex AI (used by `harvest`) — powers BOTH text embeddings
# and the Gemini grounding web-search discovery sweep. Auth is ADC — run
# `gcloud auth application-default login`; no key belongs here.
# (We use Gemini + Google Search grounding because Google closed the older
# Custom Search JSON API to new projects on 2026-01-20.)
GOOGLE_CLOUD_PROJECT=
# Optional Vertex overrides:
# VERTEX_LOCATION=us-central1
# EMBEDDING_MODEL=text-embedding-005
# GROUNDING_MODEL=gemini-2.5-flash

# Optional — raises the Semantic Scholar rate limit for citation enrichment.
# SEMANTIC_SCHOLAR_API_KEY=

# Optional — override the harvest fetch User-Agent. Defaults to a browser UA so
# publisher CDNs don't 403 us; set a transparent bot identifier here if you prefer.
# HARVEST_USER_AGENT=

# GitHub token — required only for `assemble --pr` (opening the newsletter PR).
GITHUB_TOKEN=
