---
// One of the three section cards on the landing page, adapted from
// the main site's AudienceCard.
//
// Props:
//   - label: short label, e.g. "Newsletter"
//   - tagline: one-line pitch
//   - bullets: 2-3 short bullets, what the reader gets out of it
//   - href: the link's destination
//   - linkLabel: e.g. "Browse the archive →"

interface Props {
  label: string;
  tagline: string;
  bullets: string[];
  href: string;
  linkLabel: string;
}

const { label, tagline, bullets, href, linkLabel } = Astro.props;
---

<a class="section-card" href={href}>
  <span class="section-card-label">{label}</span>
  <p class="section-card-tagline">{tagline}</p>
  <ul class="section-card-bullets">
    {bullets.map((b) => <li>{b}</li>)}
  </ul>
  <span class="section-card-cta">{linkLabel}</span>
</a>

<style>
  .section-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.25rem 1.25rem 1.1rem 1.25rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    background: var(--sl-color-bg-nav);
    color: var(--sl-color-text);
    text-decoration: none;
    transition: border-color 0.15s ease,
                transform 0.15s ease,
                background 0.15s ease;
    min-height: 12rem;
  }

  .section-card:hover {
    border-color: var(--sl-color-accent);
    transform: translateY(-2px);
  }

  .section-card-label {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--sl-color-text-accent);
  }

  .section-card-tagline {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .section-card-bullets {
    margin: 0;
    padding-left: 1.1rem;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--sl-color-gray-3);
  }

  .section-card-bullets li + li {
    margin-top: 0.2rem;
  }

  .section-card-cta {
    margin-top: auto;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--sl-color-text-accent);
  }
</style>
