---
// Shared site footer.
import { Image } from "astro:assets";
import logo from "../assets/eigenius_logo_400x400.png";
import { withBase } from "../lib/url";
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <div class="site-footer-brand">
      <Image src={logo} alt="" width={24} height={24} />
      <span>Eigenius Community</span>
    </div>
    <ul class="site-footer-links">
      <li><a href={withBase("/newsletter/")}>Newsletter</a></li>
      <li><a href={withBase("/articles/")}>Articles</a></li>
      <li><a href={withBase("/blog/")}>Blog</a></li>
      <li><a href={withBase("/research/")}>Research</a></li>
      <li><a href={withBase("/sources/")}>Sources</a></li>
      <li><a href={withBase("/people/")}>People</a></li>
      <li><a href={withBase("/rss.xml")}>RSS</a></li>
      <li><a href="https://eigenius.io">eigenius.io ↗</a></li>
      <li><a href="https://github.com/eigenius">GitHub ↗</a></li>
    </ul>
    <p class="site-footer-fineprint">
      The community site of the Eigenius project. Eigenius is open
      source under the Apache 2.0 license.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--sl-color-hairline);
    padding: 2rem 1.5rem 3rem 1.5rem;
    background: var(--sl-color-bg-nav);
  }

  .site-footer-inner {
    max-width: 72rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }

  .site-footer-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
  }

  .site-footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 1.4rem;
    flex-wrap: wrap;
  }

  .site-footer-links a {
    color: var(--sl-color-gray-3);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .site-footer-links a:hover {
    color: var(--sl-color-text-accent);
  }

  .site-footer-fineprint {
    margin: 0;
    color: var(--sl-color-gray-4);
    font-size: 0.85rem;
  }
</style>
