---
// Landing page. Introduces the community site and routes readers to
// the newsletter archive, articles, and blog. The hero reuses the
// main site's typography over a layered navy gradient instead of its
// background image, so this repo carries no multi-megabyte binary.
import { getImage } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionCard from "../components/SectionCard.astro";
import EntryCard from "../components/EntryCard.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";
import { getIssues, getPublished } from "../lib/content";
import { withBase } from "../lib/url";
import heroBgSrc from "../assets/hero_background.png";

const issues = await getIssues();
const latestIssue = issues[0];

// The most recent writing across articles and blog, interleaved.
const recent = [
  ...(await getPublished("articles")).map(
    (entry) => ({ section: "articles", entry }) as const,
  ),
  ...(await getPublished("blog")).map(
    (entry) => ({ section: "blog", entry }) as const,
  ),
]
  .sort((a, b) => b.entry.data.pubDate.valueOf() - a.entry.data.pubDate.valueOf())
  .slice(0, 3);

// Optimized hero background (the 5.8MB source PNG never ships).
const heroBg = await getImage({ src: heroBgSrc, format: "webp", width: 2752 });
---

<BaseLayout
  title="Eigenius Community — a weekly research radar"
  description="The community home of Eigenius: a weekly research radar over neurosymbolic AI, AI-driven science, formal methods and verification, and AI in the life sciences — a curated, sourced digest, with articles, a blog, and a browsable index of the field."
>
  <!-- ───────── Hero ───────── -->
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-content">
        <span class="hero-eyebrow">The Eigenius community</span>
        <h1 class="hero-headline">
          Verified Minds
        </h1>
        <p class="hero-pitch">
          A weekly brief on the frontier of reliable, agentic AI. 
          We cut through the noise to bring you the latest papers, 
          industry news, and open-source tools across four pillars: 
          autonomous AI agents, neurosymbolic logic, formal verification, 
          and applied life sciences. 
          Sourced, summarized, and strictly hype-free.
        </p>
        <div class="hero-actions">
          <a class="cta cta-primary" href={withBase("/newsletter/")}>
            Read the newsletter
          </a>
          <a class="cta cta-secondary" href="https://eigenius.io">
            About the project <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────── Section cards ───────── -->
  <section class="section section-tinted">
    <div class="section-inner">
      <span class="section-eyebrow">What's here</span>
      <h2 class="section-title">Read the digest &mdash; and browse the field.</h2>
      <div class="card-grid">
        <SectionCard
          label="Newsletter"
          tagline="One issue a week, curated from across the field."
          bullets={[
            "New papers, tools, and writing — summarized",
            "Every item linked to its primary source",
            "Archived here in full, readable without email",
          ]}
          href={withBase("/newsletter/")}
          linkLabel="Browse the archive →"
        />
        <SectionCard
          label="Articles"
          tagline="Longer-form pieces that stand on their own."
          bullets={[
            "Deep dives on concepts and open problems",
            "Perspective and analysis, not just links",
            "Written to be readable months later",
          ]}
          href={withBase("/articles/")}
          linkLabel="Read the articles →"
        />
        <SectionCard
          label="Blog"
          tagline="Shorter, timelier notes from the project."
          bullets={[
            "Project updates and announcements",
            "Meetups, talks, and community calls",
            "Quick notes between newsletter issues",
          ]}
          href={withBase("/blog/")}
          linkLabel="Read the blog →"
        />
      </div>
    </div>
  </section>

  <!-- ───────── Latest issue ───────── -->
  {
    latestIssue && (
      <section class="section">
        <div class="section-inner">
          <span class="section-eyebrow">Latest issue</span>
          <h2 class="section-title">From the newsletter.</h2>
          <ul class="post-list">
            <li class="post-item">
              <EntryCard
                section="newsletter"
                entry={latestIssue}
                chip={`Issue #${latestIssue.data.issue}`}
              />
            </li>
          </ul>
          <NewsletterSignup />
          <p class="section-footnote">
            Every issue is archived on this site and also available as an{" "}
            <a href={withBase("/newsletter/rss.xml")}>RSS feed</a>.
          </p>
        </div>
      </section>
    )
  }

  <!-- ───────── Recent writing ───────── -->
  {
    recent.length > 0 && (
      <section class="section section-tinted">
        <div class="section-inner">
          <span class="section-eyebrow">Recent writing</span>
          <h2 class="section-title">Latest articles and posts.</h2>
          <ul class="post-list">
            {recent.map(({ section, entry }) => (
              <li class="post-item">
                <EntryCard section={section} entry={entry} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- ───────── Browse the field ───────── -->
  <section class="section">
    <div class="section-inner">
      <span class="section-eyebrow">The archive, indexed</span>
      <h2 class="section-title">Browse the field.</h2>
      <p class="section-prose">
        Every issue is drawn from a growing, sourced archive &mdash; which
        doubles as a typed index of the field, the same shape Eigenius is
        built around. Explore it by{" "}
        <a href={withBase("/research/")}>research area</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style define:vars={{ heroBg: `url("${heroBg.src}")` }}>
  /* Page-unique styles; the shared chrome lives in src/styles/custom.css.
     The hero uses the main site's knowledge-graph background, with a
     left-anchored navy scrim so the hero text stays legible over it. */
  .hero {
    border-bottom: 1px solid var(--sl-color-hairline);
    background:
      linear-gradient(
        to right,
        var(--eigenius-navy-1) 0%,
        color-mix(in srgb, var(--eigenius-navy-1) 55%, transparent) 45%,
        transparent 80%
      ),
      var(--heroBg) center / cover no-repeat,
      linear-gradient(
        to bottom right,
        var(--eigenius-navy-1) 0%,
        var(--eigenius-navy-2) 55%,
        var(--eigenius-navy-3) 100%
      );
  }

  .hero-inner {
    padding: 5rem 1.5rem 6rem 1.5rem;
    max-width: 72rem;
    margin: 0 auto;
  }

  .hero-content {
    max-width: 40rem;
  }
</style>
