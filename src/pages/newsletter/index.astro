---
// Newsletter archive, highest issue number first.
import BaseLayout from "../../layouts/BaseLayout.astro";
import EntryCard from "../../components/EntryCard.astro";
import { getIssues } from "../../lib/content";
import { withBase } from "../../lib/url";

const issues = await getIssues();
---

<BaseLayout
  title="Newsletter — Eigenius Community"
  description="The weekly Eigenius newsletter: what landed, what changed, and what's next in the project, with highlights from the community. Every issue archived here."
  current="newsletter"
>
  <section class="section">
    <div class="section-inner">
      <span class="section-eyebrow">Newsletter</span>
      <h1 class="section-title">The weekly issue archive</h1>
      <p class="section-prose">
        One issue a week on the state of the Eigenius project: what
        landed, what changed, what's next, and highlights from the
        community. Every issue is published here in full.
      </p>

      {
        issues.length === 0 ? (
          <p class="section-prose post-empty">No issues yet.</p>
        ) : (
          <ul class="post-list">
            {issues.map((issue) => (
              <li class="post-item">
                <EntryCard
                  section="newsletter"
                  entry={issue}
                  chip={`Issue #${issue.data.issue}`}
                />
              </li>
            ))}
          </ul>
        )
      }

      <p class="section-footnote">
        Subscribe via the{" "}
        <a href={withBase("/newsletter/rss.xml")}>newsletter RSS feed</a>,
        or follow everything on this site through the{" "}
        <a href={withBase("/rss.xml")}>combined feed</a>. Email
        delivery is planned; until then, the feed is the way to
        subscribe.
      </p>
    </div>
  </section>
</BaseLayout>
