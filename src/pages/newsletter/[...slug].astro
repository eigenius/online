---
// A single newsletter issue. `[...slug]` (rest param) rather than
// `[slug]` so nested paths work — src/content/newsletter/2026/foo.md
// serves at /newsletter/2026/foo/.
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  getIssues,
  getIssueContext,
  entryUrl,
  formatDate,
  isoDate,
  type Issue,
} from "../../lib/content";
import { withBase } from "../../lib/url";

export async function getStaticPaths() {
  const issues = await getIssues();
  return issues.map((issue) => ({
    params: { slug: issue.id },
    props: { issue },
  }));
}

interface Props {
  issue: Issue;
}

const { issue } = Astro.props;
const { Content } = await render(issue);
const { prev, next } = await getIssueContext(issue);
---

<BaseLayout
  title={`${issue.data.title} — Eigenius Community`}
  description={issue.data.description}
  current="newsletter"
  ogType="article"
>
  <article class="section">
    <div class="post-body">
      <header>
        <a class="post-back" href={withBase("/newsletter/")}>← Newsletter</a>
        <h1 class="post-headline">{issue.data.title}</h1>
        {issue.data.subtitle && (
          <p class="post-subtitle">{issue.data.subtitle}</p>
        )}
        <p class="post-meta">
          <span>Issue #{issue.data.issue}</span>
          <span class="post-meta-sep">·</span>
          <time datetime={isoDate(issue.data.pubDate)}>
            {formatDate(issue.data.pubDate)}
          </time>
          <span class="post-meta-sep">·</span>
          <span>{issue.data.author}</span>
          {
            issue.data.updatedDate && (
              <>
                <span class="post-meta-sep">·</span>
                <span>Updated {formatDate(issue.data.updatedDate)}</span>
              </>
            )
          }
        </p>
        {
          issue.data.draft && (
            <p class="post-draft-banner">
              Draft — not included in production builds.
            </p>
          )
        }
      </header>

      <div class="post-prose">
        <Content />
      </div>

      {
        (prev || next) && (
          <nav class="post-adjacent-nav" aria-label="Adjacent issues">
            {prev ? (
              <a class="post-adjacent-link" href={entryUrl("newsletter", prev)}>
                <span class="post-adjacent-dir">← Issue #{prev.data.issue}</span>
                <span class="post-adjacent-title">{prev.data.title}</span>
              </a>
            ) : (
              <span />
            )}
            {next && (
              <a
                class="post-adjacent-link post-adjacent-link-next"
                href={entryUrl("newsletter", next)}
              >
                <span class="post-adjacent-dir">Issue #{next.data.issue} →</span>
                <span class="post-adjacent-title">{next.data.title}</span>
              </a>
            )}
          </nav>
        )
      }
    </div>
  </article>
</BaseLayout>

<style is:global>
  /* Progressive-disclosure cards for newsletter items. The radar renders these
     as raw HTML inside .post-prose, so the styles must be global (content from
     <Content /> doesn't receive Astro's scoped attribute). Selectors are scoped
     to .nl-* so they only touch newsletter items. */
  .post-prose .nl-context {
    margin: 0.25rem 0 1.15rem;
    padding-left: 0.9rem;
    border-left: 2px solid var(--sl-color-hairline);
    color: var(--sl-color-gray-3);
    font-size: 0.97rem;
  }
  .post-prose details.nl-item {
    border: 1px solid var(--sl-color-hairline);
    border-radius: 10px;
    margin: 0.7rem 0;
    background: color-mix(in srgb, var(--sl-color-bg-nav) 45%, transparent);
  }
  .post-prose details.nl-item > summary {
    list-style: none;
    cursor: pointer;
    padding: 0.85rem 2.4rem 0.85rem 1.1rem;
    position: relative;
  }
  .post-prose details.nl-item > summary::-webkit-details-marker {
    display: none;
  }
  .post-prose details.nl-item > summary::after {
    content: "›";
    position: absolute;
    right: 1.1rem;
    top: 0.78rem;
    font-size: 1.2rem;
    color: var(--sl-color-gray-3);
    transition: transform 0.15s ease;
  }
  .post-prose details.nl-item[open] > summary::after {
    transform: rotate(90deg);
  }
  .post-prose details.nl-item[open] > summary {
    border-bottom: 1px solid var(--sl-color-hairline);
  }
  .post-prose .nl-item-title {
    display: block;
    font-weight: 600;
    color: var(--sl-color-text);
    line-height: 1.35;
  }
  .post-prose details.nl-item > summary:hover .nl-item-title {
    color: var(--sl-color-text-accent);
  }
  .post-prose .nl-item-meta {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.82rem;
    color: var(--sl-color-gray-3);
  }
  .post-prose .nl-item-body {
    padding: 0.9rem 1.1rem 1rem;
  }
  .post-prose .nl-item-body > p {
    margin: 0 0 0.6rem;
  }
  .post-prose .nl-item-more {
    margin: 0;
    font-size: 0.9rem;
  }
</style>
