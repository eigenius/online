---
// A single article. `[...slug]` (rest param) rather than `[slug]` so
// nested paths work — src/content/articles/2026/foo.md serves at
// /articles/2026/foo/.
import EntryLayout from "../../layouts/EntryLayout.astro";
import { getPublished, type Entry } from "../../lib/content";

export async function getStaticPaths() {
  const articles = await getPublished("articles");
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

interface Props {
  article: Entry;
}

const { article } = Astro.props;
---

<EntryLayout entry={article} section="articles" backLabel="Articles" />
